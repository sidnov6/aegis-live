# --- Live feeds (all free; BTC + exchange are keyless) ---------------------
ENABLE_BTC=true
ENABLE_EXCHANGE=true
ENABLE_ETH=false
# ETH pending-tx needs a free WebSocket RPC key, e.g. from a node provider:
# ETH_WS_URL=wss://eth-mainnet.example/ws?key=YOUR_KEY

# --- Demo fallback (keeps the wall alive on locked-down networks) ----------
DEMO_FALLBACK=true
DEMO_INJECT_SANCTIONS=true

# --- Stream / backpressure -------------------------------------------------
BUS_MAXSIZE=5000
SAMPLE_RATE=1.0
# REDIS_URL=redis://localhost:6379        # optional Upstash Redis Streams

# --- Scoring ---------------------------------------------------------------
ALERT_THRESHOLD=0.72
SANCTIONS_HOP_LIMIT=2
ENABLE_GNN=false

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///data/aegis.db
# DATABASE_URL=postgresql://user:pass@host:5432/db   # Supabase/Neon

# --- SAR drafting (LLM via LiteLLM; empty => deterministic template) -------
# SAR_MODEL=groq/llama-3.1-70b-versatile
# GROQ_API_KEY=...
# SAR_MODEL=gemini/gemini-1.5-flash
# GEMINI_API_KEY=...
# SAR_MODEL=ollama/llama3                 # fully local floor
